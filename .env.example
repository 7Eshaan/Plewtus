# Generate a private key, for example with: openssl rand -hex 32
PLEWTUS_API_KEY=replace-with-a-long-random-key

# Optional host ports
FRONTEND_PORT=3000
BACKEND_PORT=8080

# Optional frontend per-process rate guard (requests per minute per client)
PLEWTUS_RATE_LIMIT_PER_MINUTE=20
# "true" only behind a reverse proxy that appends X-Forwarded-For
PLEWTUS_TRUST_PROXY_HEADERS=false

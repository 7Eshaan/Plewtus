# Plewtus Frontend Environment Variables
# NOTE: Never use NEXT_PUBLIC_ for backend credentials. These must remain strictly server-side.

# URL of the running Go Plewtus backend
PLEWTUS_BACKEND_URL=http://localhost:8080

# Demo API Key sent server-to-server to the backend
PLEWTUS_API_KEY=pro_live_agent123

# Frontend Route Handler per-process rate guard (requests per minute, per client).
PLEWTUS_RATE_LIMIT_PER_MINUTE=20

# Set to "true" only when a reverse proxy you control sits in front of Next.js
# and appends the client address to X-Forwarded-For. Otherwise forwarded
# headers are ignored (they are trivially spoofable) and all visitors share one
# rate-limit bucket. On Vercel the platform header is trusted automatically.
PLEWTUS_TRUST_PROXY_HEADERS=false

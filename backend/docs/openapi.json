{
  "openapi": "3.1.0",
  "info": {
    "title": "Plewtus Metasearch API",
    "version": "0.1.0",
    "description": "Plewtus is an AI-agent search API backend that aggregates search results across\nmultiple search engines (DuckDuckGo, Bing, Yahoo, and opt-in Marginalia, Brave and Qwant) using metasearch architecture.\nResults are normalized, deduplicated, filtered for relevance, and ranked with\nReciprocal Rank Fusion (RRF) plus a small query-relevance boost,\nwith optional AI-friendly webpage extraction (clean text, highlights, Markdown).\n",
    "license": {
      "name": "Apache-2.0",
      "identifier": "Apache-2.0"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Local development server"
    }
  ],
  "paths": {
    "/search": {
      "post": {
        "summary": "Execute federated search",
        "description": "Dispatches concurrent search queries across upstream search engines, normalizes,\nfilters and deduplicates results, ranks with Reciprocal Rank Fusion (RRF) plus a small\nrelevance boost, and optionally extracts webpage content for AI agents.\n",
        "operationId": "search",
        "security": [
          {
            "BearerAuth": []
          },
          {
            "ApiKeyAuth": []
          },
          {}
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRequest"
              },
              "examples": {
                "simple": {
                  "summary": "Simple search query",
                  "value": {
                    "query": "golang concurrency patterns",
                    "limit": 10
                  }
                },
                "filtered": {
                  "summary": "Filtered search with recency and domain inclusion",
                  "value": {
                    "query": "machine learning benchmarks",
                    "freshness": "month",
                    "include_domains": [
                      "arxiv.org",
                      "paperswithcode.com"
                    ],
                    "limit": 5
                  }
                },
                "with_extraction": {
                  "summary": "Search with AI Markdown extraction",
                  "value": {
                    "query": "go standard library net/http",
                    "limit": 3,
                    "extract": {
                      "enabled": true,
                      "mode": "markdown",
                      "max_pages": 3,
                      "max_chars_per_page": 4000
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful search execution with unified results and metadata.",
            "headers": {
              "X-RateLimit-Limit": {
                "schema": {
                  "type": "integer"
                },
                "description": "Maximum requests allowed per minute in active tier."
              },
              "X-RateLimit-Remaining": {
                "schema": {
                  "type": "integer"
                },
                "description": "Remaining requests in current rate limit window."
              },
              "X-RateLimit-Reset": {
                "schema": {
                  "type": "integer"
                },
                "description": "Seconds until rate limit bucket refills."
              },
              "X-Quota-Limit": {
                "schema": {
                  "type": "integer"
                },
                "description": "Daily request quota limit."
              },
              "X-Quota-Remaining": {
                "schema": {
                  "type": "integer"
                },
                "description": "Remaining requests for current UTC day."
              },
              "X-Quota-Reset": {
                "schema": {
                  "type": "integer"
                },
                "description": "Seconds until daily quota resets at 00:00:00 UTC."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request (malformed JSON or validation error).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized (missing or invalid API key when auth is required).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "408": {
            "description": "The client cancelled the request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests (rate limit or daily quota exceeded).",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                },
                "description": "Seconds to wait before retrying request."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error (all providers failed or unexpected failure).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "504": {
            "description": "The search exceeded its time budget.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health check",
        "description": "Returns server status, version, and uptime.",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Server is healthy.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "summary": "Health check alias",
        "description": "Kubernetes-style health probe alias for /health.",
        "operationId": "getHealthz",
        "responses": {
          "200": {
            "description": "Server is healthy.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Supply API key as Bearer token in Authorization header."
      },
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "Supply API key via X-API-Key header."
      }
    },
    "schemas": {
      "SearchRequest": {
        "type": "object",
        "required": [
          "query"
        ],
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "description": "Search query string (at most 500 characters).",
            "example": "golang concurrency patterns"
          },
          "limit": {
            "type": "integer",
            "default": 10,
            "minimum": 1,
            "maximum": 50,
            "description": "Maximum number of ranked results to return. Windows deeper than about 10 results make each engine fetch further result pages (up to 3), which is slower and best-effort."
          },
          "offset": {
            "type": "integer",
            "default": 0,
            "minimum": 0,
            "maximum": 49,
            "description": "Pagination offset. offset + limit must not exceed the 50-result provider window."
          },
          "providers": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "duckduckgo",
                "bing",
                "yahoo",
                "marginalia",
                "brave",
                "qwant"
              ]
            },
            "description": "Optional list of search engines to query. Defaults to PLEWTUS_DEFAULT_PROVIDERS (duckduckgo, bing, yahoo). marginalia, brave and qwant are opt-in. Marginalia has a mostly English index, supports only the 'year' freshness window, and its shared public API key is heavily rate limited (set PLEWTUS_MARGINALIA_API_KEY). Brave's HTML page usually answers non-browser clients with a captcha, so set PLEWTUS_BRAVE_API_KEY to use Brave's official Search API. Qwant is only available in some countries, sits behind bot protection, and has no freshness filter."
          },
          "freshness": {
            "type": "string",
            "enum": [
              "day",
              "week",
              "month",
              "year"
            ],
            "description": "Optional discovery recency filter."
          },
          "include_domains": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Restrict search results strictly to these domains or subdomains.",
            "example": [
              "go.dev",
              "golang.org"
            ]
          },
          "exclude_domains": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Exclude any search results originating from these domains or subdomains.",
            "example": [
              "pinterest.com"
            ]
          },
          "country": {
            "type": "string",
            "pattern": "^[a-zA-Z]{2}$",
            "description": "2-letter ISO 3166-1 alpha-2 country code.",
            "example": "us"
          },
          "language": {
            "type": "string",
            "pattern": "^[a-zA-Z]{2}$",
            "description": "2-letter ISO 639-1 language code.",
            "example": "en"
          },
          "extract": {
            "$ref": "#/components/schemas/ExtractOptions"
          }
        }
      },
      "ExtractOptions": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean",
            "description": "Whether to fetch and extract webpage content for discovered results.",
            "default": false
          },
          "mode": {
            "type": "string",
            "enum": [
              "highlights",
              "markdown",
              "text",
              "metadata"
            ],
            "default": "highlights",
            "description": "Content extraction format."
          },
          "max_pages": {
            "type": "integer",
            "default": 3,
            "minimum": 1,
            "maximum": 10,
            "description": "Maximum number of top results to extract content from."
          },
          "max_chars_per_page": {
            "type": "integer",
            "default": 4000,
            "minimum": 1,
            "maximum": 20000,
            "description": "Maximum character limit per extracted page."
          }
        }
      },
      "SearchResponse": {
        "type": "object",
        "required": [
          "query",
          "results",
          "metadata"
        ],
        "properties": {
          "query": {
            "type": "string",
            "description": "The echoed normalized search query."
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SearchResult"
            }
          },
          "metadata": {
            "$ref": "#/components/schemas/SearchMetadata"
          }
        }
      },
      "SearchResult": {
        "type": "object",
        "required": [
          "id",
          "title",
          "url",
          "snippet",
          "rank",
          "score",
          "relevance_score",
          "ranking_score",
          "engines"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the deduplicated result.",
            "example": "res_1"
          },
          "title": {
            "type": "string",
            "description": "Cleaned, non-truncated webpage title."
          },
          "url": {
            "type": "string",
            "description": "Destination URL with redirect wrappers, fragments, and tracking parameters removed; otherwise as reported by the engine.",
            "example": "https://go.dev/blog/pipelines"
          },
          "snippet": {
            "type": "string",
            "description": "Relevant summary snippet."
          },
          "rank": {
            "type": "integer",
            "description": "Unified ranking position (1-based).",
            "example": 1
          },
          "score": {
            "type": "number",
            "format": "double",
            "description": "Raw Reciprocal Rank Fusion (RRF) consensus score, sum of 1/(60 + position) over engines. Results are ordered by ranking_score.",
            "example": 0.04918
          },
          "relevance_score": {
            "type": "number",
            "format": "double",
            "description": "Query relevance score derived from term coverage, title matches, and exact phrase matches."
          },
          "ranking_score": {
            "type": "number",
            "format": "double",
            "description": "Ordering score, normalized RRF consensus scaled by a small relevance boost (consensus x (0.98 + 0.02 x relevance_score)). Results are sorted by this value."
          },
          "engines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EngineSource"
            },
            "description": "Search engines that independently discovered this result."
          },
          "published_date": {
            "type": "string",
            "description": "Publication date extracted from SERP or document.",
            "example": "Mar 13, 2014"
          },
          "content": {
            "$ref": "#/components/schemas/ExtractedContent"
          },
          "content_error": {
            "type": "string",
            "description": "Present when extraction was attempted for this result but produced no content; explains why (blocked address, non-HTML page, timeout)."
          }
        }
      },
      "EngineSource": {
        "type": "object",
        "required": [
          "name",
          "position"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Search engine name (duckduckgo, bing, yahoo, marginalia, brave, qwant).",
            "example": "duckduckgo"
          },
          "position": {
            "type": "integer",
            "description": "1-based original ranking position on engine SERP.",
            "example": 1
          }
        }
      },
      "ExtractedContent": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Page title from Open Graph/Twitter metadata or the <title> tag."
          },
          "markdown": {
            "type": "string",
            "description": "Clean Markdown representation of webpage content."
          },
          "text": {
            "type": "string",
            "description": "Plain text extracted from primary article elements."
          },
          "highlights": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Salient snippet highlights scored against search query."
          },
          "author": {
            "type": "string",
            "description": "Extracted author from HTML meta tags."
          },
          "description": {
            "type": "string",
            "description": "Meta description tag value."
          },
          "extracted_at": {
            "type": "string",
            "format": "date-time",
            "description": "UTC timestamp when extraction was performed."
          }
        }
      },
      "SearchMetadata": {
        "type": "object",
        "required": [
          "total_results",
          "took_ms",
          "providers",
          "stats",
          "timestamp"
        ],
        "properties": {
          "total_results": {
            "type": "integer",
            "description": "Number of results returned in this response."
          },
          "took_ms": {
            "type": "integer",
            "description": "Total request execution time in milliseconds."
          },
          "providers": {
            "$ref": "#/components/schemas/ProviderMetadata"
          },
          "stats": {
            "$ref": "#/components/schemas/SearchStats"
          },
          "filters": {
            "$ref": "#/components/schemas/AppliedFilters"
          },
          "cached": {
            "type": "boolean",
            "description": "Indicates whether this response was served directly from in-memory cache."
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "RFC3339 UTC timestamp."
          }
        }
      },
      "ProviderMetadata": {
        "type": "object",
        "required": [
          "queried",
          "successful",
          "failed",
          "timing_ms"
        ],
        "properties": {
          "queried": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Engine names dispatched."
          },
          "successful": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Engine names that successfully returned results."
          },
          "failed": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProviderError"
            },
            "description": "Engines that failed, timed out, or encountered open circuit breakers."
          },
          "timing_ms": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "format": "int64"
            },
            "description": "Per-provider elapsed time in milliseconds for completed attempts."
          }
        }
      },
      "ProviderError": {
        "type": "object",
        "required": [
          "engine",
          "error"
        ],
        "properties": {
          "engine": {
            "type": "string",
            "description": "Failing search engine name."
          },
          "error": {
            "type": "string",
            "description": "Granular description of failure or circuit breaker state."
          }
        }
      },
      "SearchStats": {
        "type": "object",
        "required": [
          "raw_count",
          "deduped_count",
          "relevance_rejected_count",
          "domain_rejected_count",
          "invalid_url_count",
          "duplicate_count",
          "provider_discarded_count"
        ],
        "properties": {
          "raw_count": {
            "type": "integer",
            "description": "Total raw results retrieved across all engines before deduplication."
          },
          "deduped_count": {
            "type": "integer",
            "description": "Total unique results identified after canonical URL normalization."
          },
          "relevance_rejected_count": {
            "type": "integer",
            "description": "Deduplicated results removed because they did not match the query."
          },
          "domain_rejected_count": {
            "type": "integer",
            "description": "Raw candidates rejected by include/exclude domain filters."
          },
          "invalid_url_count": {
            "type": "integer",
            "description": "Raw candidates rejected because their destination URL was empty or invalid."
          },
          "duplicate_count": {
            "type": "integer",
            "description": "Candidates merged into an already-seen canonical destination URL."
          },
          "provider_discarded_count": {
            "type": "integer",
            "description": "Raw results dropped because their whole provider response was discarded as off-topic. raw_count equals deduped_count plus the five rejection and merge counters."
          }
        }
      },
      "AppliedFilters": {
        "type": "object",
        "properties": {
          "freshness": {
            "type": "string"
          },
          "include_domains": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "exclude_domains": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "country": {
            "type": "string"
          },
          "language": {
            "type": "string"
          },
          "offset": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "required": [
          "status",
          "version",
          "uptime_seconds",
          "timestamp"
        ],
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          },
          "version": {
            "type": "string",
            "example": "0.1.0"
          },
          "uptime_seconds": {
            "type": "number",
            "format": "double",
            "example": 125.4
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error",
          "message",
          "code"
        ],
        "properties": {
          "error": {
            "type": "string",
            "description": "Short machine-readable error token.",
            "example": "rate_limit_exceeded"
          },
          "message": {
            "type": "string",
            "description": "Human-readable error explanation.",
            "example": "Rate limit exceeded: limit 10 req/min for tier 'free' (retry in 12s)"
          },
          "code": {
            "type": "integer",
            "description": "HTTP status code.",
            "example": 429
          }
        }
      }
    }
  }
}
